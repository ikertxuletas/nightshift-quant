{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "titulo", "fuente", "tipo", "forma", "universo", "gestion", "estado"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_-]{3,80}$"},
    "titulo": {"type": "string", "minLength": 3},
    "fuente": {"type": "object", "required": ["url", "cita"], "additionalProperties": false,
      "properties": {"url": {"type": "string", "minLength": 3}, "autor": {"type": "string"},
                     "fecha": {"type": "string"}, "cita": {"type": "string", "minLength": 1}}},
    "tipo": {"enum": ["tendencia", "reversion", "ruptura", "carry", "estacionalidad",
                      "momentum_transversal", "pares", "volatilidad", "otro"]},
    "forma": {"enum": ["serie_temporal", "transversal"]},
    "universo": {"type": "object", "required": ["instrumentos", "plazo"], "additionalProperties": false,
      "properties": {"instrumentos": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                     "plazo": {"enum": ["M5", "M15", "H1", "H4", "D1", "W1"]}}},
    "entrada": {"$ref": "#/$defs/lados"},
    "salida": {"$ref": "#/$defs/lados"},
    "transversal": {"type": "object", "required": ["ranking", "cada_barras", "top"], "additionalProperties": false,
      "properties": {"ranking": {"type": "string"}, "cada_barras": {"type": "integer", "minimum": 1},
                     "top": {"type": "integer", "minimum": 1}, "bottom": {"type": "integer", "minimum": 0},
                     "filtro": {"$ref": "#/$defs/cond"}}},
    "gestion": {"type": "object", "additionalProperties": false,
      "properties": {"stop": {"$ref": "#/$defs/stop"}, "objetivo": {"$ref": "#/$defs/objetivo"},
                     "trailing": {"$ref": "#/$defs/distancia"},
                     "max_barras": {"type": ["integer", "null"], "minimum": 1},
                     "perdida_diaria_max": {"type": "number", "exclusiveMinimum": 0},
                     "parar_tras_objetivo": {"type": "boolean"},
                     "tamano": {"type": "object", "required": ["tipo", "valor"], "additionalProperties": false,
                       "properties": {"tipo": {"enum": ["riesgo", "unidades"]},
                                      "valor": {"type": "number", "exclusiveMinimum": 0}}}}},
    "horario": {"type": "object", "additionalProperties": false,
      "properties": {"sesiones": {"type": "array", "items": {"type": "object", "required": ["desde", "hasta"],
                       "additionalProperties": false,
                       "properties": {"desde": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
                                      "hasta": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"}}}},
                     "dias": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 6}},
                     "cierre": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
                     "zona": {"type": "string", "minLength": 3}}},
    "prometido": {"type": "object", "additionalProperties": false,
      "properties": {"sharpe": {"type": "number"}, "drawdown": {"type": "number"}, "cagr": {"type": "number"},
                     "acierto": {"type": "number"}, "periodo": {"type": "string"},
                     "con_costes": {"type": "boolean"}, "cita": {"type": "string"}}},
    "umbrales_tipo": {"type": "array", "items": {"type": "object",
      "required": ["metrica", "valor", "sentido", "fuente"], "additionalProperties": false,
      "properties": {"metrica": {"enum": ["sharpe", "drawdown", "cagr", "acierto", "profit_factor"]},
                     "valor": {"type": "number"}, "sentido": {"enum": ["min", "max"]},
                     "fuente": {"type": "string", "minLength": 3}}}},
    "supuestos": {"type": "array", "items": {"type": "string"}},
    "estado": {"enum": ["borrador", "aprobada", "no_expresable", "incompleta", "rechazada"]},
    "historial": {"type": "array"}
  },
  "$defs": {
    "operando": {"type": ["string", "number"]},
    "par": {"type": "array", "items": {"$ref": "#/$defs/operando"}, "minItems": 2, "maxItems": 2},
    "cond": {"oneOf": [
      {"type": "object", "required": ["y"], "additionalProperties": false,
       "properties": {"y": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cond"}}}},
      {"type": "object", "required": ["o"], "additionalProperties": false,
       "properties": {"o": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cond"}}}},
      {"type": "object", "required": ["no"], "additionalProperties": false,
       "properties": {"no": {"$ref": "#/$defs/cond"}}},
      {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false,
       "properties": {"<": {"$ref": "#/$defs/par"}, ">": {"$ref": "#/$defs/par"},
                      "<=": {"$ref": "#/$defs/par"}, ">=": {"$ref": "#/$defs/par"},
                      "cruza_arriba": {"$ref": "#/$defs/par"}, "cruza_abajo": {"$ref": "#/$defs/par"}}}
    ]},
    "lados": {"type": "object", "additionalProperties": false,
      "properties": {"largo": {"$ref": "#/$defs/cond"}, "corto": {"$ref": "#/$defs/cond"}}},
    "stop": {"oneOf": [{"$ref": "#/$defs/distancia"},
      {"type": "object", "required": ["tipo", "valor"], "additionalProperties": false,
       "properties": {"tipo": {"const": "barras"}, "valor": {"type": "integer", "minimum": 1}}}]},
    "objetivo": {"oneOf": [{"$ref": "#/$defs/distancia"},
      {"type": "object", "required": ["tipo", "valor"], "additionalProperties": false,
       "properties": {"tipo": {"const": "rango_dia"}, "valor": {"type": "number", "exclusiveMinimum": 0}}}]},
    "distancia": {"oneOf": [{"type": "null"},
      {"type": "object", "required": ["tipo", "valor"], "additionalProperties": false,
       "properties": {"tipo": {"enum": ["atr", "pct"]}, "valor": {"type": "number", "exclusiveMinimum": 0}}}]}
  }
}
